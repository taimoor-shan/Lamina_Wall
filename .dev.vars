# Wrangler local secrets — never commit. Mirrors `wrangler secret put` on
# Workers. Test secret below pairs with the 1x… site key (always passes).
# Real keys replace these in production via `wrangler secret put`.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Local E2E only: an invalid key proves the Resend leg executes and fails
# at the network boundary. Production uses `wrangler secret put RESEND_API_KEY`.
RESEND_API_KEY=re_dummy_local_test_key
# RESEND_FROM / RESEND_TO default to hello@lamina.studio (footer contact).
