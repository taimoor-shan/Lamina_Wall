---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';

// M0 pipeline proof: schema-validated content files -> typed data ->
// validated reference() links -> build-time image optimisation.
// M3 replaces this page with the full approved homepage layout.
const collections = (await getCollection('collections')).sort(
  (a, b) => a.data.order - b.data.order,
);
const products = await getCollection('products');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LAMINA — Wall Panels &amp; Architectural Surfaces</title>
    <meta
      name="description"
      content="Wood grain, stone, metal and textile wall panels for architects, designers and trade buyers."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="logo">LAMINA</div>
      <nav class="links" aria-label="Primary">
        {
          collections.map((c) => <a href={`#${c.data.slug}`}>{c.data.title}</a>)
        }
      </nav>
    </header>

    <main>
      <section class="intro">
        <div class="eyebrow">Architectural Surfaces — 2026 Collection</div>
        <h1 class="display">
          Surfaces with<span class="i">provenance.</span>
        </h1>
        <p class="intro-copy">
          Foundation build — every swatch below renders from a
          schema-validated content file through <code>astro:assets</code>.
        </p>
      </section>

      {
        collections.map((c) => {
          const items = products
            .filter((p) => p.data.collection.id === c.id)
            .sort((a, b) => a.data.order - b.data.order);
          return (
            <section class="collection" id={c.data.slug}>
              <div class="sec-head">
                <div>
                  <div class="num">
                    0{c.data.order} / {c.data.title}
                  </div>
                  <h2 class="display">{c.data.tagline}</h2>
                </div>
                <p>{c.data.description}</p>
              </div>
              <div class="swatch-row">
                {items.map((p) => (
                  <article class="swatch">
                    <div class="swatch-img">
                      <Image
                        src={p.data.swatchImage}
                        alt={p.data.alt}
                        width={720}
                        height={486}
                        densities={[1, 2]}
                      />
                    </div>
                    <div class="swatch-meta">
                      <div class="txt">
                        <div class="code">{p.data.code}</div>
                        <div class="name">{p.data.name}</div>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          );
        })
      }

      <section class="pipeline-note">
        <p class="eyebrow">M0 — content pipeline verified</p>
        <p>
          {collections.length} collections, {products.length} products, all
          types generated from <code>src/content.config.ts</code>.
        </p>
      </section>
    </main>

    <footer class="site-footer">
      <div class="logo">LAMINA</div>
      <p>Wall panels &amp; architectural surfaces. Wood, stone, metal and
        textile finishes for commercial and residential interiors.</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px var(--gutter);
    background: rgba(231, 226, 214, 0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .logo {
    font-family: var(--font-serif);
    font-size: var(--fs-logo);
    letter-spacing: 0.02em;
  }
  .links {
    display: flex;
    gap: 34px;
    font-size: 13.5px;
    letter-spacing: 0.01em;
  }
  .links a {
    position: relative;
    padding-bottom: 2px;
    color: var(--ink);
    opacity: 0.75;
  }
  .links a:hover {
    opacity: 1;
  }

  .intro {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 120px var(--gutter) 40px;
    border-bottom: 1px solid var(--line);
  }
  .intro h1 {
    font-size: var(--fs-display-xl);
    margin-top: 14px;
  }
  .intro .i {
    font-style: italic;
  }
  .intro-copy {
    margin-top: 26px;
    max-width: 360px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ash);
  }
  .intro-copy code,
  .pipeline-note code {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--stone-card);
    padding: 1px 5px;
  }

  section.collection {
    padding: var(--section-v) var(--gutter) 40px;
    max-width: var(--container-max);
    margin: 0 auto;
  }
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--sec-head-gap);
    gap: 40px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 28px;
  }
  .sec-head .num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ash);
  }
  .sec-head h2 {
    font-size: var(--fs-display-lg);
    margin-top: 8px;
  }
  .sec-head p {
    max-width: 360px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ash);
    padding-bottom: 6px;
  }

  .swatch-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
  }
  .swatch {
    background: var(--paper);
    position: relative;
  }
  .swatch-img {
    aspect-ratio: 4 / 2.7;
    overflow: hidden;
  }
  .swatch-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
  }
  .swatch-meta .txt {
    line-height: 1.35;
  }
  .swatch-meta .code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--ash);
  }
  .swatch-meta .name {
    font-size: 13.5px;
    margin-top: 2px;
  }

  .pipeline-note {
    max-width: var(--container-max);
    margin: 80px auto 0;
    padding: var(--section-v) var(--gutter);
    background: var(--basalt);
    color: var(--paper);
  }
  .pipeline-note .eyebrow {
    color: var(--sand-deep);
    margin-bottom: 18px;
  }
  .pipeline-note p {
    max-width: 520px;
    color: var(--sand);
    font-size: 15px;
    line-height: 1.6;
  }

  .site-footer {
    background: var(--basalt);
    color: var(--ash-dark);
    padding: 0 var(--gutter) 46px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 12.5px;
  }
  .site-footer .logo {
    color: var(--sand);
  }
  .site-footer p {
    max-width: 260px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .swatch-row {
      grid-template-columns: repeat(2, 1fr);
    }
    .links {
      gap: 18px;
      font-size: 12px;
    }
  }
</style>