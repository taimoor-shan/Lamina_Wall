---
import { getCollection } from 'astro:content';
import '../styles/tokens.css';
import '../styles/global.css';

import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import IndexStrip from '../components/IndexStrip.astro';
import CollectionSpread from '../components/CollectionSpread.astro';
import StatementBanner from '../components/StatementBanner.astro';
import Footer from '../components/Footer.astro';
import RequestTray from '../components/RequestTray.svelte';

import heroImage from '../assets/applications/hero-001.jpeg';

const collections = (await getCollection('collections')).sort(
  (a, b) => a.data.order - b.data.order,
);
const products = await getCollection('products');

const productsByCollection = new Map<string, typeof products>();
for (const p of products) {
  const cid = p.data.collection.id;
  if (!productsByCollection.has(cid)) productsByCollection.set(cid, []);
  productsByCollection.get(cid)!.push(p);
}
for (const arr of productsByCollection.values()) {
  arr.sort((a, b) => a.data.order - b.data.order);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LAMINA — Wall Panels &amp; Architectural Surfaces</title>
    <meta
      name="description"
      content="Wood grain, stone, metal and textile wall panels for architects, designers and trade buyers."
    />
    <meta property="og:title" content="LAMINA — Wall Panels & Architectural Surfaces" />
    <meta
      property="og:description"
      content="Wood grain, stone, metal and textile wall panels for architects, designers and trade buyers."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts stylesheet loads async (media swap): it is the only render-
         blocking request to a third party, costing ~1s of FCP on throttled
         mobile. display=swap already lets text paint in a fallback face. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <Nav collections={collections} trayCount={0} />

    <main>
      <Hero
        image={heroImage}
        alt="Wood-panelled living room with warm oak grain"
        eyebrow="Architectural Surfaces — 2026 Collection"
        lines={[
          { text: 'Surfaces with' },
          { text: 'provenance.', italic: true },
        ]}
        sub="Wood, stone, metal and textile, reproduced with the grain, depth and hand-feel of the original material. Specified by the panel, not the pallet."
        linkHref="#wood-grain"
        linkLabel="View the collections ↓"
        callout={{ code: 'WG-01', name: 'Classic Technology Wood' }}
      />

      <IndexStrip collections={collections} />

      {
        collections.map((c) => (
          <CollectionSpread
            collection={c}
            products={productsByCollection.get(c.id) ?? []}
          />
        ))
      }

      <StatementBanner
        eyebrow="For Architects, Designers & Trade Buyers"
        line1="No prices to guess at."
        line2="No cart to abandon."
        body="Select article numbers as you browse — they collect quietly in your Request tray. Add quantities, project details and your team's contact information, and we'll come back with lead times and a formal quote."
      />
    </main>

    <Footer />
    <RequestTray client:load />
  </body>
</html>
