---
// Collection page — /collections/[slug], generated from Content Collections
// (PRD M3): section head + application photography + full swatch filmstrip.
// Composed entirely from existing components so the page inherits the
// approved mockup's design system; no new design is invented here.
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import '../../styles/tokens.css';
import '../../styles/global.css';

import Nav from '../../components/Nav.astro';
import SectionHead from '../../components/SectionHead.astro';
import AppShowcase from '../../components/AppShowcase.astro';
import SwatchCard from '../../components/SwatchCard.astro';
import Footer from '../../components/Footer.astro';
import RequestTray from '../../components/RequestTray.svelte';

// Note: getStaticPaths must fetch its own data — the Cloudflare adapter
// evaluates it in the prerender server without module-level scope.
export async function getStaticPaths() {
  const collections = (await getCollection('collections')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return collections.map((collection) => ({
    params: { slug: collection.data.slug },
    props: { collection },
  }));
}

interface Props {
  collection: CollectionEntry<'collections'>;
}

const { collection } = Astro.props;
const allCollections = (await getCollection('collections')).sort(
  (a, b) => a.data.order - b.data.order,
);
const {
  order,
  title,
  tagline,
  description,
  heroAlt,
  secondaryApplicationAlt,
} = collection.data;
const index = String(order).padStart(2, '0');
const pageTitle = `${title} — LAMINA`;

// The full filmstrip: every swatch in this collection, in catalogue order.
// (The homepage spread shows five with a dialog; the collection page is the
// complete list — no "+N more" needed.)
const products = (await getCollection('products'))
  .filter((p) => p.data.collection.id === collection.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Async fonts stylesheet — see index.astro for rationale. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body>
    <Nav collections={allCollections} />

    <main class="collection-page">
      <SectionHead
        index={index}
        name={title}
        title={tagline}
        description={description}
        level={1}
      />
      <AppShowcase
        primary={collection.data.heroApplicationImage}
        primaryAlt={heroAlt}
        secondary={collection.data.secondaryApplicationImage}
        secondaryAlt={secondaryApplicationAlt}
        title={title}
        order={order}
        priority
      />
      <div class="filmstrip">
        {products.map((p) => (
          <SwatchCard product={p} />
        ))}
      </div>
    </main>

    <Footer />
    <RequestTray client:load />
  </body>
</html>

<style>
  .collection-page {
    padding: var(--section-v) var(--gutter) 40px;
    max-width: var(--container-max);
    margin: 0 auto;
  }
  /* Full filmstrip: same 5-up grid as the homepage row, but complete.
     On mobile it switches to 2-up (the homepage row hides there; a
     collection page has no dialog fallback, so the filmstrip must stay). */
  .filmstrip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: var(--line);
  }
  @media (max-width: 900px) {
    .filmstrip {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
