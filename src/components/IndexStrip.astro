---
// IndexStrip — sticky mono index of collection anchors (mockup lines 45-52).
import type { CollectionEntry } from 'astro:content';

interface Props {
  collections: CollectionEntry<'collections'>[];
}

const { collections } = Astro.props;
---

<div class="index-strip" role="navigation" aria-label="Collections index">
  {
    collections.map((c) => (
      <a href={`#${c.data.slug}`}>
        <b>{String(c.data.order).padStart(2, '0')}</b>
        {c.data.title}
      </a>
    ))
  }
</div>

<style>
  .index-strip {
    position: sticky;
    top: var(--index-strip-top);
    z-index: 40;
    display: flex;
    gap: 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }
  .index-strip a {
    font-family: var(--font-mono);
    font-size: var(--fs-label-btn);
    letter-spacing: 0.04em;
    padding: 14px 26px;
    border-right: 1px solid var(--line);
    white-space: nowrap;
    color: var(--ash);
  }
  .index-strip a b {
    color: var(--ink);
    font-weight: 400;
    margin-right: 8px;
  }
  .index-strip a:hover {
    color: var(--ink);
    background: var(--stone-card);
  }
</style>