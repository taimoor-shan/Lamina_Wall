---
// Hero — full-bleed background with optional video support.
//
// Two modes, selected by props:
//   image only (default)  → tiered CSS background-image, scrim via --hero-veil
//   video provided         → <video> fills the section, image becomes poster,
//                            scrim is an explicit overlay <div>
//
// The image always runs through astro:assets so the poster is an optimised
// WebP at the largest viewport tier (no raw source ships to the client).
import { getImage } from 'astro:assets';

interface Line {
  text: string;
  italic?: boolean;
}
interface Props {
  image: ImageMetadata;
  eyebrow: string;
  lines: Line[];
  sub: string;
  linkHref: string;
  /** Secondary CTA (the catalogue-PDF download). Optional: the second button
   *  renders only when the caller has a real target (R3 gates it on
   *  public/catalogue.pdf existing at build time). */
  linkPdfHref?: string;
  linkLabel?: string;
  linkLabel1?: string;
  /** Optional video URL/path. When set, the hero renders a <video> element
   *  with the optimised image as poster and the scrim as a separate overlay.
   *  When absent, the existing image-background behaviour is used unchanged. */
  video?: string;
}

const {
  image,
  eyebrow,
  lines,
  sub,
  linkHref,
  linkPdfHref,
  linkLabel = 'View the collections',
  linkLabel1 = 'Download the Catalog',
  video,
} = Astro.props;

const hasVideo = !!video;

// Always optimise the image — used as tiered background (image mode) or as
// the largest-tier poster (video mode, no double-download on the poster).
const [bgSmall, bgMid, bgLarge] = await Promise.all([
  getImage({ src: image, format: 'webp', width: 640 }),
  getImage({ src: image, format: 'webp', width: 1280 }),
  getImage({ src: image, format: 'webp', width: 1920 }),
]);

const tieredBgCss = hasVideo
  ? ''
  : `
    .hero {
      background-image: var(--hero-veil), url('${bgSmall.src}');
    }
    @media (min-width: 960px) {
      .hero {
        background-image: var(--hero-veil), url('${bgMid.src}');
      }
    }
    @media (min-width: 1280px) {
      .hero {
        background-image: var(--hero-veil), url('${bgLarge.src}');
      }
    }
  `;

// Video-mode styles are emitted ONLY when a video is actually used (same
// set:html pattern as tieredBgCss), so a photo-mode page ships zero
// absolute/fixed positioning from the hero (Session-10 client directive:
// "must not have any absolute element").
const videoCss = hasVideo
  ? `
    .hero-media {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .hero-media video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .hero-veil {
      position: absolute;
      inset: 0;
      background: var(--hero-veil);
      pointer-events: none;
    }
  `
  : '';
---

<section class="hero">
  {hasVideo && (
    <>
      <style is:inline set:html={videoCss}></style>
      <div class="hero-media">
        <video
          src={video}
          poster={bgLarge.src}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        />
        <div class="hero-veil" aria-hidden="true"></div>
      </div>
    </>
  )}

  {!hasVideo && (
    <style is:inline set:html={tieredBgCss}></style>
  )}

  <div class="hero-content">
    <div class="hero-headline">
      <div class="eyebrow">{eyebrow}</div>
      <h1 class="display">
        {
          lines.map((l, i) => (
            <span>
              {i > 0 ? <br /> : ''}
              {l.italic ? <span class="i">{l.text}</span> : l.text}
            </span>
          ))
        }
      </h1>
    </div>
    <div class="hero-sub">
      <p>{sub}</p>
      <div class="flex mt-3">
        <a type="button" class="btn-outline white" href={linkHref}>{linkLabel}</a>
        {linkPdfHref && (
          <a type="button" class="btn-outline" href={linkPdfHref}>{linkLabel1}</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: var(--hero-h);
    min-height: var(--hero-min-h);
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 0 var(--gutter);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;

  }

  /* Video-mode rules (.hero-media/.hero-veil) are injected conditionally as
     inline CSS when the video prop is set — see videoCss above. Photo mode
     (the default, used by the landing page) ships no absolute elements. */

  /* ---- shared content ---- */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 500px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5em;
    /* margin-top:80px; */
  }
  .hero-headline .eyebrow {
    color: var(--sand-soft);
    margin-bottom: 18px;
  }
  .hero-headline h1 {
    font-size: var(--fs-display-hero);
    color: var(--paper);
  }
  .hero-sub {
    color: var(--paper-soft);
    font-size: var(--fs-hero-sub);
    line-height: 1.55;
    padding-bottom: 10px;
  }
  .hero-sub a.white {
    display: inline-block;
    color: var(--ink);
    background-color: var(--paper-soft);
  }
</style>
