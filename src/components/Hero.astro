---
// Hero — full-bleed application photo as the section's CSS background with
// the headline in normal flow: flex-centered vertically, left-aligned,
// subtext + link below the headline as before (mockup lines 29-43).
//
// No absolute positioning anywhere: the dark scrim is the --hero-veil
// gradient layered over the photo inside the same background-image, and the
// floating material callout is gone. The photo is one build-time WebP per
// viewport tier (media-queried like an img srcset) — tiers match the
// preload widths in index.astro so preload and background resolve to the
// same candidate per viewport (no double download).
//
// Astro does not template expressions inside <style>; the background URLs
// ship through <style is:inline set:html> (same pattern as Fonts.astro).
import { getImage } from 'astro:assets';

interface Line {
  text: string;
  italic?: boolean;
}
interface Props {
  image: ImageMetadata;
  eyebrow: string;
  lines: Line[];
  sub: string;
  linkHref: string;
  linkLabel?: string;
}

const { image, eyebrow, lines, sub, linkHref, linkLabel = 'View the collections' } = Astro.props;

const [bgSmall, bgMid, bgLarge] = await Promise.all([
  getImage({ src: image, format: 'webp', width: 640 }),
  getImage({ src: image, format: 'webp', width: 1280 }),
  getImage({ src: image, format: 'webp', width: 1920 }),
]);

const heroCss = `
  .hero {
    background-image: var(--hero-veil), url('${bgSmall.src}');
  }
  @media (min-width: 960px) {
    .hero {
      background-image: var(--hero-veil), url('${bgMid.src}');
    }
  }
  @media (min-width: 1280px) {
    .hero {
      background-image: var(--hero-veil), url('${bgLarge.src}');
    }
  }
`;
---

<style is:inline set:html={heroCss}></style>

<section class="hero">
  <div class="hero-content">
    <div class="hero-headline">
      <div class="eyebrow">{eyebrow}</div>
      <h1 class="display">
        {
          lines.map((l, i) => (
            <span>
              {i > 0 ? <br /> : ''}
              {l.italic ? <span class="i">{l.text}</span> : l.text}
            </span>
          ))
        }
      </h1>
    </div>
    <div class="hero-sub">
      <p>{sub}</p>
      <a href={linkHref}>{linkLabel}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Photo + scrim as the CSS background; content in normal flow below. */
    height: var(--hero-h);
    min-height: var(--hero-min-h);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    padding: 0 var(--gutter);
  }
  .hero-content {
    max-width: 500px;
    width:100%;
    display: flex;
    flex-direction: column;
    gap: 1.5em;
  }
  .hero-headline .eyebrow {
    color: var(--sand-soft);
    margin-bottom: 18px;
  }
  .hero-headline h1 {
    font-size: var(--fs-display-hero);
    color: var(--paper);
  }
  .hero-sub {
    color: var(--paper-soft);
    font-size: var(--fs-hero-sub);
    line-height: 1.55;
    padding-bottom: 10px;
  }
  .hero-sub a {
    display: inline-block;
    margin-top: 2em;
    font-family: var(--font-mono);
    font-size: var(--fs-label-lg);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--paper-soft);
    padding-bottom: 3px;
    color: var(--paper-soft);
  }
</style>
