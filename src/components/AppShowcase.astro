---
// AppShowcase — the collection's application photography: two images on a
// 12-column grid (main spans 8, secondary spans 4) with the mono caption
// row beneath. Extracted from CollectionSpread per client directive
// ("show 2 images in a grid of 8 and 4 columns"). Stacks full-width on
// mobile.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  primary: ImageMetadata;
  primaryAlt: string;
  secondary: ImageMetadata;
  secondaryAlt: string;
  /** Optional caption for the photography; defaults to "<title> — application". */
  caption?: string;
  title: string;
  order: number;
  /** Priority-load the primary image — used on collection pages where the
      application photo is the page hero (above the fold). */
  priority?: boolean;
}

const { primary, primaryAlt, secondary, secondaryAlt, caption, title, order, priority = false } =
  Astro.props;
---

<div class="app-showcase">
  <div class="app-grid">
    <div class="app-main">
      <Image
        src={primary}
        alt={primaryAlt}
        widths={[640, 1024, 1920]}
        sizes="(max-width: 900px) 100vw, 70vw"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
      />
    </div>
    <div class="app-side">
      <Image
        src={secondary}
        alt={secondaryAlt}
        widths={[480, 720]}
        sizes="(max-width: 900px) 100vw, 35vw"
        loading="lazy"
      />
    </div>
  </div>
  <!-- <div class="app-caption">
    <span>{caption ?? `${title} — application`}</span>
    <span>Fig. {String(order).padStart(2, "0")}</span>
  </div> -->
</div>

<style>
  .app-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1em;
    margin-bottom: 1em;
  }
  .app-main {
    grid-column: span 8;
    aspect-ratio: var(--app-ratio);
    overflow: hidden;
    box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
  }
  .app-side {
    /* No aspect of its own — stretches to the main image's grid row height. */
    grid-column: span 4;
    overflow: hidden;
  }
  .app-main :global(img),
  .app-side :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .app-caption {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--fs-caption);
    color: var(--ash);
    padding: 10px 2px 20px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 30px;
  }

  @media (max-width: 900px) {
    /* Stack the pair full-width; each keeps the standard app ratio. */
    .app-grid {
      grid-template-columns: 1fr;
    }
    .app-main,
    .app-side {
      grid-column: auto;
    }
    .app-side {
      aspect-ratio: var(--app-ratio);
    }
  }
</style>
