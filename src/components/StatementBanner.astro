---
// StatementBanner — dark request statement block (mockup .statement) that
// closes the landing page with the R3 CTA row:
//   Download catalogue PDF (rendered only when the caller has the asset —
//   gated on public/catalogue.pdf existing at build time, R3)
//   Request samples      — opens the request tray: the island's delegated
//                          click handler catches [data-tray-open], and the
//                          [data-tray-count] span mirrors the tray's total
//                          like the header Request button (Session 10).
//   Contact              — plain mailto link (the mockup footer's STUDIO
//                          email is the site's contact affordance).
interface Props {
  eyebrow: string;
  line1: string;
  line2?: string; // italic line
  body: string;
  /** Set to '/catalogue.pdf' to render the download action. */
  pdfHref?: string;
  /** Label for the tray-opening action. */
  trayLabel?: string;
  /** Target for the contact action (defaults to the STUDIO email). */
  contactHref?: string;
}

const {
  eyebrow,
  line1,
  line2,
  body,
  pdfHref,
  trayLabel = 'Request samples',
  contactHref = 'mailto:hello@lamina.studio',
} = Astro.props;
const PDF_LABEL = 'Download catalogue PDF';
const CONTACT_LABEL = 'Contact';
---

<div class="statement">
  <div class="eyebrow">{eyebrow}</div>
  <h2 class="display">
    {line1}
    {line2 && (
      <>
        <br />
        <span class="i">{line2}</span>
      </>
    )}
  </h2>
  <p>{body}</p>

  <div class="cta-row">
    {pdfHref && (
      <a class="btn" href={pdfHref} download>{PDF_LABEL}</a>
    )}
    <button
      class="btn"
      type="button"
      data-tray-open
      aria-label={`${trayLabel} — opens the request tray`}
    >
      {trayLabel} <span data-tray-count aria-hidden="true">(0)</span>
    </button>
    <a class="btn" href={contactHref}>{CONTACT_LABEL}</a>
  </div>
</div>

<style>
  .statement {
    background: var(--basalt);
    color: var(--paper);
    padding: var(--section-v) var(--gutter);
    margin-top: 80px;
    text-align: center;
  }
  .statement .eyebrow {
    color: var(--sand-deep);
    justify-content: center;
    display: flex;
    margin-bottom: 26px;
  }
  .statement h2 {
    font-size: var(--fs-display-md);
    max-width: 900px;
    margin: 0 auto 34px;
  }
  .statement p {
    max-width: 520px;
    margin: 0 auto 40px;
    color: var(--sand);
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
  }
  .statement .btn {
    display: inline-block;
    background: transparent;
    border: 1px solid var(--paper);
    padding: 16px 34px;
    font-family: var(--font-mono);
    font-size: var(--fs-label-btn);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    color: var(--paper);
  }
  .statement .btn:hover {
    background: var(--paper);
    color: var(--basalt);
  }

  /* R3 CTA row — three equal actions in the same outline language; the
     group wraps on narrow widths and stacks below 480px. */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px 16px;
    max-width: 900px;
    margin: 0 auto;
  }
  @media (max-width: 480px) {
    .cta-row {
      flex-direction: column;
    }
    .cta-row .btn {
      width: min(100%, 320px);
    }
  }
</style>
