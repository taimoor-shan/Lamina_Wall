---
// CollectionSpread — full collection section from the mockup: SectionHead +
// application photography (AppShowcase) + swatch grid. Desktop shows the
// first five swatches; if the collection has more, the last card carries a
// "+N more" overlay opening CollectionDialog's lightbox. On mobile the row
// is hidden entirely — a "View available options" button opens the same
// dialog, which holds every swatch in the collection.
import type { CollectionEntry } from "astro:content";
import SectionHead from "./SectionHead.astro";
import AppShowcase from "./AppShowcase.astro";
import SwatchCard from "./SwatchCard.astro";
import CollectionDialog from "./CollectionDialog.astro";

interface Props {
  collection: CollectionEntry<"collections">;
  products: CollectionEntry<"products">[];
  /** Optional caption for the application photography (AppShowcase). */
  caption?: string;
}

const { collection, products, caption } = Astro.props;
const {
  slug,
  order,
  tagline,
  description,
  heroApplicationImage,
  heroAlt,
  secondaryApplicationImage,
  secondaryApplicationAlt,
  title,
} = collection.data;
const visible = products.slice(0, 5);
const remaining = Math.max(0, products.length - visible.length);
const dialogId = `dlg-${slug}`;
---

<section class="collection" id={slug}>
  <SectionHead
    index={String(order).padStart(2, "0")}
    name={title}
    title={tagline}
    description={description}
  />
  <AppShowcase
    primary={heroApplicationImage}
    primaryAlt={heroAlt}
    secondary={secondaryApplicationImage}
    secondaryAlt={secondaryApplicationAlt}
    caption={caption}
    title={title}
    order={order}
  />
  <div class="swatch-row">
    {visible.map((p, i) => (
      <div class="swatch-cell">
        <SwatchCard product={p} />
        {remaining > 0 && i === visible.length - 1 && (
          <button
            class="more-overlay"
            type="button"
            data-dialog-open={dialogId}
            aria-haspopup="dialog"
          >
            +{remaining} more
          </button>
        )}
      </div>
    ))}
  </div>
  <button
    class="view-options"
    type="button"
    data-dialog-open={dialogId}
    aria-haspopup="dialog"
  >
    View available options
  </button>
  <CollectionDialog
    id={dialogId}
    title={title}
    order={order}
    products={products}
  />
</section>

<style>
  section.collection {
    padding: var(--section-v) var(--gutter) 40px;
    max-width: var(--container-max);
    margin: 0 auto;
  }
  .swatch-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: var(--line);
  }
  .swatch-cell {
    position: relative;
    min-width: 0;
  }

  /* "+N more" overlay tile — desktop only; mobile gets the button below */
  .more-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border: none;
    background: var(--swatch-overlay);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: var(--fs-label-btn);
    letter-spacing: var(--ls-mono-wide);
    text-transform: uppercase;
    cursor: pointer;
  }
  .more-overlay:hover {
    background: var(--swatch-overlay-strong);
  }

  .view-options {
    display: none;
    width: 100%;
    margin-top: 20px;
    padding: 14px 16px;
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--fs-label-btn);
    letter-spacing: var(--ls-mono-wide);
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    /* Mobile: the filmstrip is replaced by the lightbox — hide the row and
       keep only the "View available options" button. */
    .swatch-row {
      display: none;
    }
    .view-options {
      display: block;
    }
  }
</style>
