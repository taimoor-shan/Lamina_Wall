---
// CollectionDialog — full-screen lightbox showing every swatch in a
// collection (native <dialog>). Opened by triggers carrying
// data-dialog-open={id} (the "+N more" tile and mobile button rendered by
// CollectionSpread). The bundled script wires all dialogs on the page once.
import type { CollectionEntry } from "astro:content";
import SwatchCard from "./SwatchCard.astro";

interface Props {
  id: string;
  title: string;
  order: number;
  products: CollectionEntry<"products">[];
}

const { id, title, order, products } = Astro.props;
---

<dialog
  class="collection-dialog"
  id={id}
  aria-label={`All ${title} swatches`}
>
  <div class="dlg-head">
    <span class="dlg-title">{String(order).padStart(2, "0")} / {title}</span>
    <button class="dlg-close" type="button" data-dialog-close aria-label="Close">
      ✕
    </button>
  </div>
  <div class="dlg-grid">
    {products.map((p) => (
      <SwatchCard product={p} />
    ))}
  </div>
</dialog>

<style>
  .collection-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    background: var(--stone);
    color: var(--ink);
  }
  .collection-dialog::backdrop {
    background: var(--dlg-backdrop);
  }
  .dlg-head {
    position: sticky;
    top: 0;
        z-index: 99;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px var(--gutter);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .dlg-title {
    font-family: var(--font-mono);
    font-size: var(--fs-label-btn);
    letter-spacing: var(--ls-mono-wide);
    text-transform: uppercase;
  }
  .dlg-close {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    font-size: 16px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .dlg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1px;
    padding: 20px var(--gutter) 60px;
    overflow-y: auto;
  }

  @media (max-width: 900px) {
    .dlg-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  // Wires every "+N more" tile / "View available options" button to its
  // collection's <dialog>. Static page: one bundled script, DOM is ready.
  document.querySelectorAll<HTMLElement>("[data-dialog-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const dlg = document.getElementById(btn.dataset.dialogOpen ?? "");
      if (dlg instanceof HTMLDialogElement) dlg.showModal();
    });
  });
  document.querySelectorAll<HTMLElement>("[data-dialog-close]").forEach((btn) => {
    btn.addEventListener("click", () => btn.closest("dialog")?.close());
  });
  document.querySelectorAll<HTMLDialogElement>(".collection-dialog").forEach((dlg) => {
    // Click on the dimmed backdrop (the dialog itself, not its children) closes.
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
  });
</script>
